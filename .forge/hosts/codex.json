{
  "host": "codex",
  "label": "Codex (OpenAI)",
  "output_path": ".agents/skills/{name}/SKILL.md",
  "default_model": "gpt",
  "tool_names": {
    "read": "read_file",
    "write": "create_file",
    "edit": "apply_patch",
    "bash": "shell",
    "grep": "search",
    "glob": "search",
    "ask": "ask_user",
    "subagent": "spawn"
  },
  "invocation": "/<alias> (custom prompt) or AGENTS.md routing",
  "command_path": ".codex/prompts/{alias}.md",
  "command_style": "prompt",
  "notes": "Reads AGENTS.md at repo root and custom prompts from .codex/prompts (invoked as /alias). Tool names differ from Claude; mapped above."
}
