# General
node_modules/
.DS_Store
.env
.env.*
*.local
secrets/
dist/
# Root-only: a real build-output dir. Anchored so it never catches the
# engineering/build SKILL directory (.forge and .agents), which must ship.
/build/
_input/

# IDEs
.vscode/
.idea/
.antigravity-images/

# Resonance Protocol
# We explicitly want to track the memory bank (The Brain)
!.resonance/*.md


# Security: Never commit secrets or temporary context dumps
.resonance/secrets/
.resonance/tmp/
.resonance/scripts/boot.local

# Website (separate repository)
website/
temp
temp_clones/
.antigravity-images
__pycache__/

# Runtime state (generated by loop_state.py / run_evals.py)
.resonance/goal_state.json
.forge/eval_results.json

# Machine-local overlay (the flagship's own memory and hooks; never shipped)
CLAUDE.local.md
.claude/settings.local.json
.claude/worktrees/
